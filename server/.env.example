# Copy to server/.env. Only needed for natural-language filters; everything else works without it.
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Comma-separated models from https://openrouter.ai/models?max_price=0, tried in order
# (OpenRouter falls back to the next one if a model is rate-limited or down).
# Leave empty to use the defaults in server/src/nl-filters.ts.
OPENROUTER_MODEL=
