# Copy to server/.env. Only needed for natural-language filters; everything else works without it.
# Pick ONE of the two options below.

# Option 1: OpenRouter (free models, shared and sometimes rate-limited)
# Free key: https://openrouter.ai/keys
LLM_API_KEY=
# Optional: comma-separated models, tried in order. Leave empty for the defaults in server/src/nl-filters.ts
LLM_MODEL=

# Option 2: a local model with Ollama (https://ollama.com). No key, no rate limits.
#   ollama pull gemma3:12b
# LLM_API_URL=http://localhost:11434/v1
# LLM_MODEL=gemma3:12b
